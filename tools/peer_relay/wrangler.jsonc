{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retrorecomped-peer-relay",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "PEER_ROOMS", "class_name": "PeerRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PeerRoom"] }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
