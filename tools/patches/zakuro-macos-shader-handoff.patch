+/// Whether this unit can already use the native SIMD program. Querying it
+/// starts the usual asynchronous compilation; it never waits for that work.
+pub(crate) fn vertices_are_compiled(unit: &ShaderUnit) -> bool {
+    if log::log_enabled!(target: "zakuro_gpu::shader::nan", log::Level::Trace) { return false; }
+    #[cfg(feature = "jit")]
+    { return unit.decoded.as_ref().and_then(|program| jit::compiled(unit, program)).is_some(); }
+    #[cfg(not(feature = "jit"))]
+    { let _ = unit; false }
+}
