 }
+
+// An application bundle selects its own reviewed loader without DYLD setup.
+pub(crate) fn entry() -> Result<ash::Entry, ash::LoadingError> {
+    match std::env::var_os("RETRO_3DS_VULKAN_LIBRARY") {
+        Some(path) => unsafe { ash::Entry::load_from(path) },
+        None => unsafe { ash::Entry::load() },
+    }
+}
