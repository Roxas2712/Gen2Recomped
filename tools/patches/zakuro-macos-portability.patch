diff --git a/crates/zakuro-gpu/src/portability.rs b/crates/zakuro-gpu/src/portability.rs
new file mode 100644
index 0000000..14ecb1c
--- /dev/null
+++ b/crates/zakuro-gpu/src/portability.rs
@@ -0,0 +1,28 @@
+//! macOS portability support by Roxas2712; retain upstream MIT notices.
+
+use ash::vk;
+use std::ffi::c_char;
+
+pub(crate) fn instance(entry: &ash::Entry, extensions: &mut Vec<*const c_char>) -> vk::InstanceCreateFlags {
+    if cfg!(target_os = "macos") {
+        // SAFETY: querying extensions does not require an instance.
+        let available = unsafe { entry.enumerate_instance_extension_properties(None) }.unwrap_or_default();
+        let name = ash::khr::portability_enumeration::NAME;
+        if available.iter().any(|item| item.extension_name_as_c_str() == Ok(name)) {
+            extensions.push(name.as_ptr());
+            return vk::InstanceCreateFlags::ENUMERATE_PORTABILITY_KHR;
+        }
+    }
+    vk::InstanceCreateFlags::empty()
+}
+
+pub(crate) fn device(instance: &ash::Instance, physical: vk::PhysicalDevice, extensions: &mut Vec<*const c_char>) {
+    if cfg!(target_os = "macos") {
+        // SAFETY: physical belongs to the supplied live instance.
+        let available = unsafe { instance.enumerate_device_extension_properties(physical) }.unwrap_or_default();
+        let name = ash::khr::portability_subset::NAME;
+        if available.iter().any(|item| item.extension_name_as_c_str() == Ok(name)) {
+            extensions.push(name.as_ptr());
+        }
+    }
+}
