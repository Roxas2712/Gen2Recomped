 /// the part of a buffer's upright picture a screen shows. a row of the
 /// buffer is a column of the picture, and a row's first pixels are the
 /// bottom of the screen, a longer row reaches past its top.
+/// Keep the two batch snapshots required by display transfers, plus at most
+/// one retired allocation. Never mutate bytes still borrowed by a presenter.
+/// Integration by Roxas2712; avoids large malloc/madvise churn during swaps.
+fn keep_picture(pictures: &mut VecDeque<(u64, Arc<Vec<u8>>)>, spare: &mut Option<Arc<Vec<u8>>>, batch: u64, data: &[u8]) {
+    let mut image = spare.take().unwrap_or_else(|| Arc::new(Vec::new()));
+    if let Some(bytes) = Arc::get_mut(&mut image) {
+        bytes.resize(data.len(), 0);
+        bytes.copy_from_slice(data);
+    } else {
+        image = Arc::new(data.to_vec());
+    }
+    pictures.push_back((batch, image));
+    while pictures.len() > 2 {
+        *spare = pictures.pop_front().map(|(_, image)| image);
+    }
+}
