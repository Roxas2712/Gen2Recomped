+#[cfg(test)]
+mod readback_pool_tests {
+    use super::*;
+
+    #[test]
+    fn recycles_only_retired_exclusive_allocations() {
+        let (mut pictures, mut spare) = (VecDeque::new(), None);
+        for batch in 0..3 { keep_picture(&mut pictures, &mut spare, batch, &[batch as u8; 32]); }
+        let ptr = spare.as_ref().unwrap().as_ptr();
+        keep_picture(&mut pictures, &mut spare, 3, &[3; 32]);
+        assert_eq!(pictures.back().unwrap().1.as_ptr(), ptr);
+        assert_eq!(pictures.iter().map(|(batch, _)| *batch).collect::<Vec<_>>(), [2, 3]);
+    }
+
+    #[test]
+    fn a_presenter_keeps_immutable_pixels_across_later_frames() {
+        let (mut pictures, mut spare) = (VecDeque::new(), None);
+        keep_picture(&mut pictures, &mut spare, 0, &[7; 32]);
+        let held = pictures[0].1.clone();
+        for batch in 1..20 { keep_picture(&mut pictures, &mut spare, batch, &[batch as u8; 32]); }
+        assert_eq!(held.as_slice(), &[7; 32]);
+        assert_eq!(pictures.len(), 2);
+        assert!(spare.is_some());
+    }
+
+    #[test]
+    fn resized_snapshots_have_no_stale_tail() {
+        let (mut pictures, mut spare) = (VecDeque::new(), Some(Arc::new(vec![9; 100])));
+        keep_picture(&mut pictures, &mut spare, 1, &[3; 8]);
+        assert_eq!(pictures[0].1.as_slice(), &[3; 8]);
+    }
+}
