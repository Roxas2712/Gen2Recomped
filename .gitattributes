# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts must stay LF even on a Windows checkout: build_android.ps1
# runs them through WSL/Git Bash, scripts/build_xbox_uwp.sh REQUIRES Git Bash,
# and bash fails on CRLF with $'\r'.
#
# `scripts/*.sh` matched one level only, so everything under scripts/switch/
# and scripts/xbox-uwp/ was checked out CRLF and could not run at all -- which
# is what a Switch or Xbox build hit before it ever reached a compiler.  The
# `**` form covers the subdirectories.  After changing this, run:
#     git add --renormalize . && git commit -m "normalise shell scripts to LF"
*.sh text eol=lf
scripts/**/*.sh text eol=lf
build-rg34xxsp.sh text eol=lf
install-rg34xxsp.sh text eol=lf
mobile/android/gradlew text eol=lf
*.command text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

# Pinned upstream notices are authenticated as exact bytes in the converter
# bundle. Windows checkout must not rewrite their line endings.
tools/slang-import/licenses/** -text

# This server reward is canonical SaveSerializer output. Keep its exact LF
# bytes on Windows as well; the native byte-for-byte compatibility gate
# must not depend on the checkout platform.
tests/engine/fixtures/wonder_reward.lua text eol=lf

# The selected-mod path probe asserts these exact canonical bytes. Keep the
# fixture LF on Windows; mod:read must return raw bytes without translation.
"tests/modkit/fixtures/path probe/payload.txt" text eol=lf
